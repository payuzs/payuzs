{
  "name": "@payuzs/sdk",
  "version": "0.1.0",
  "description": "Unified zero-dependency Uzbekistan payment gateway SDK",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./click": {
      "import": {
        "types": "./dist/click.d.mts",
        "default": "./dist/click.mjs"
      },
      "require": {
        "types": "./dist/click.d.cts",
        "default": "./dist/click.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/click.ts src/core.ts --dts -f esm,cjs"
  },
  "dependencies": {
    "@payuzs/click": "workspace:*",
    "@payuzs/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
